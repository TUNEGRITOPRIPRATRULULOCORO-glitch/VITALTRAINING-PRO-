# -----------------------------------------
# VITAL TRAINING — Variables de entorno
# Copia este archivo como .env y ajusta los valores.
# En local no hace falta ninguna: la app arranca con valores de desarrollo.
# -----------------------------------------

# Puerto del servidor (por defecto 4000)
PORT=4000

# Clave secreta para firmar las sesiones (JWT).
# Obligatoria en producción: usa una cadena larga y aleatoria.
JWT_SECRET=cambia-esto-por-una-clave-larga-y-aleatoria

# Tiempo de expiración de la sesión (ejemplos: 8h, 1d, 7d)
JWT_EXPIRES_IN=8h

# Base de datos PostgreSQL (Neon, Railway, Docker...).
# Sin esta variable la app usa una base local guardada en base-de-datos/datos-locales/
# DATABASE_URL=postgresql://usuario:clave@servidor/base?sslmode=require

# --- Solo producción (NODE_ENV=production) ---
# NODE_ENV=production
# Contraseña del usuario admin@vital.com (obligatoria en producción)
# ADMIN_PASSWORD=
# true = crea las cuentas de prueba y datos de ejemplo (para una demo)
# DATOS_DEMO=false
# Si la interfaz se sirve desde otro dominio, ponerlo aquí
# CORS_ORIGIN=https://tu-dominio.com

# --- Correos (opcional, ver docs/DESPLIEGUE.md#correos-opcional) ---
# Sin estas variables los correos se muestran en la consola del servidor.
# BREVO_API_KEY=xkeysib-...
# CORREO_REMITENTE=tu-correo-verificado@gmail.com
# CORREO_NOMBRE=Vital Sports
# Dirección pública para los enlaces (en Render se detecta sola)
# APP_URL=https://tu-dominio.com
