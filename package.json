{
  "name": "vital-training",
  "version": "1.0.0",
  "description": "Sistema de gestión deportiva para futbolistas, nutricionistas y administradores",
  "main": "servidor/server.js",
  "scripts": {
    "start": "node servidor/server.js",
    "dev": "node servidor/server.js",
    "demo": "node scripts/datos-demo.js",
    "test": "jest --forceExit",
    "test:coverage": "jest --coverage --forceExit",
    "test:watch": "jest --watch"
  },
  "keywords": [
    "futbol",
    "nutricion",
    "salud",
    "deportes"
  ],
  "author": "Vital Training Team",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@electric-sql/pglite": "0.5.8",
    "bcrypt": "^6.0.0",
    "dotenv": "^17.4.2",
    "express": "^4.22.1",
    "express-rate-limit": "^8.5.2",
    "google-auth-library": "^10.5.0",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.21.0",
    "pg-mem": "^1.9.17"
  },
  "devDependencies": {
    "jest": "^29.7.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.test.js"
    ],
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "servidor/api/**/*.service.js",
      "servidor/api/**/*.calculos.js",
      "servidor/api/**/*.catalogo.js",
      "base-de-datos/db.js",
      "servidor/compartido/middleware/auth.js",
      "!servidor/api/ia/ia.service.js"
    ],
    "coverageThreshold": {
      "global": {
        "lines": 60
      }
    }
  },
  "engines": {
    "node": ">=20"
  }
}
